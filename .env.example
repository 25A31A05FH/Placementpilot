# Local SQLite is the default. For a local MySQL 8+ database, set DB_ENGINE=mysql.
DB_ENGINE=mysql
DB_NAME=placementpilot
DB_USER=root
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306

# Required production settings. Use a long, unique random secret and turn DEBUG off.
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost

# For Railway media persistence, mount a volume at /app/media and set this value.
MEDIA_ROOT=/app/media
